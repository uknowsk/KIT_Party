rules_version = '2';
// 회비장부 보안 규칙
// - 회원(승인된 사람)은 모두 읽기 가능, 메시지 쓰기와 투표만 가능
// - 돈과 관련된 기록은 총무만 쓰기 가능
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function isMember() { return signedIn() && exists(/databases/$(db)/documents/users/$(request.auth.uid)); }
    function isTreasurer() { return isMember() && me().role == 'treasurer'; }
    // 회장: 설정(config/settings)의 presidentId가 내 회원 id
    function isPresident() {
      return isMember() && get(/databases/$(db)/documents/config/settings).data.get('presidentId', '') == me().memberId;
    }
    function canManageEvents() { return isTreasurer() || isPresident(); }
    // 처음 설정: 아직 아무도 설정하지 않았고, 같은 묶음 저장에 내 이름으로 setup 표시가 들어갈 때만.
    function bootstrapping() {
      return signedIn()
        && !exists(/databases/$(db)/documents/meta/setup)
        && getAfter(/databases/$(db)/documents/meta/setup).data.by == request.auth.uid;
    }

    match /meta/setup {
      allow get: if signedIn();
      allow create: if bootstrapping();
    }

    match /config/{doc} {
      allow read: if isMember();
      allow write: if isTreasurer() || bootstrapping();
    }

    match /members/{memberId} {
      // 가입 화면에서 이름을 고르려면 로그인만 해도 명단은 보여야 해요.
      allow read: if signedIn();
      allow write: if isTreasurer() || bootstrapping();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMember());
      allow write: if isTreasurer() || (bootstrapping() && request.auth.uid == uid);
    }

    match /joinRequests/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || isTreasurer());
      allow delete: if isTreasurer();
    }

    match /transactions/{id} {
      allow read: if isMember();
      allow write: if (isTreasurer() || bootstrapping())
        && (request.resource == null || (request.resource.data.amount is int && request.resource.data.amount >= 0));
    }

    match /messages/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.pinned == false
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000;
      allow delete: if isMember() && (resource.data.authorUid == request.auth.uid || isTreasurer());
      allow update: if isTreasurer() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned']);
    }

    // 모임 기록(참석자 포함): 총무·회장만 쓰기
    match /meetings/{id} {
      allow read: if isMember();
      allow write: if canManageEvents();
    }

    // 공지·투표: 총무·회장이 올리고, 회원은 열린 투표에 '내 표'만 바꿀 수 있어요.
    match /notices/{id} {
      allow read: if isMember();
      allow create, delete: if canManageEvents();
      allow update: if canManageEvents()
        || (isMember()
          && resource.data.closed == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([me().memberId])
          && request.resource.data.votes[me().memberId] is list
          && request.resource.data.votes[me().memberId].size() <= 20);
    }
  }
}
